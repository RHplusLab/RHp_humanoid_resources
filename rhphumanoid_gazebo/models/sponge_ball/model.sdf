<?xml version="1.0" ?>
<!-- 공: 지름 7 cm, 12~13 g 스펀지공 (docs/arena.md) -->
<sdf version="1.6">
  <model name="sponge_ball">
    <link name="link">
      <inertial>
        <mass>0.013</mass>
        <!-- 속이 찬 구: 2/5 m r^2 -->
        <inertia>
          <ixx>6.37e-6</ixx><iyy>6.37e-6</iyy><izz>6.37e-6</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <surface>
          <!-- 스펀지: 잘 미끄러지지 않음 -->
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <material>
          <ambient>1.0 0.45 0.0 1</ambient>
          <diffuse>1.0 0.45 0.0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
