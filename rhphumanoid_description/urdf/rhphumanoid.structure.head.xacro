<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- head -->
  <xacro:macro name="rhphumanoid_head" params="parent">

  <!-- head yaw joint -->
  <joint name="head_pan" type="revolute">
    <parent link="${parent}"/>
    <child link="head_pan_link"/>
    <origin xyz="0.01841 0.0 0.1365" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="${45*9.80665/100}" velocity="${(pi/3)/0.18}" lower="${-pi*2/3}" upper="${pi*2/3}" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>
  <!-- <xacro:insert_transmission name="head_pan" /> -->

  <!-- head yaw link -->
  <link name="head_pan_link">
    <visual>
      <xacro:insert_mesh_head_pan_link />
    </visual>
    <!-- <collision>
      <xacro:insert_mesh_head_pan_link />
    </collision> -->
    <collision>
      <origin xyz="0.004670 0.000000 0.007000" rpy="0 0 0"/>
      <geometry>
        <box size="0.049950 0.040000 0.053500"/>
      </geometry>
    </collision>
    <inertial>
      <xacro:insert_inertia_head_pan_link />
    </inertial>
  </link>

  <!-- head pitch joint -->
  <joint name="head_tilt" type="revolute">
    <parent link="head_pan_link"/>
    <child link="head_tilt_link"/>
    <origin xyz="0.01391 0.01538 0.01710" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit effort="${45*9.80665/100}" velocity="${(pi/3)/0.18}" lower="${-pi*2/3}" upper="${pi*2/3}" />
    <dynamics damping="0.1" friction="0.0" />
  </joint>
  <!-- <xacro:insert_transmission name="head_tilt" /> -->

  <!-- head yaw link -->
  <link name="head_tilt_link">
    <visual>
      <xacro:insert_mesh_head_tilt_link />
    </visual>
    <!-- <collision>
      <xacro:insert_mesh_head_tilt_link />
    </collision> -->
    <collision>
      <origin xyz="0.010980 -0.014970 0.021020" rpy="0 0 0"/>
      <geometry>
        <box size="0.058010 0.040000 0.052110"/>
      </geometry>
    </collision>
    <inertial>
      <xacro:insert_inertia_head_tilt_link />
    </inertial>
  </link>

  <!-- camera joint -->
  <joint name="cam" type="fixed">
    <origin xyz="0.040 -0.015 0.027" rpy="${-pi*0.5} 0 ${-pi*0.5}"/>
    <parent link="head_tilt_link"/>
    <child link="cam_link"/>
  </joint>

  <joint name="cam_gazebo" type="fixed">
    <origin xyz="0.040 -0.015 0.027" rpy="0 0 0"/>
    <parent link="head_tilt_link"/>
    <child link="cam_gazebo_link"/>
  </joint>

  <!-- camera link -->
  <link name="cam_link">
  </link>

  <!-- camera link -->
  <link name="cam_gazebo_link">
  </link>

  </xacro:macro>

</robot>
